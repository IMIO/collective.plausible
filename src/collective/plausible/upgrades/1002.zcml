<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:gs="http://namespaces.zope.org/genericsetup"
    >

  <gs:registerProfile
      name="1002"
      title="Replace action linking to @@plausible-view"
      description="Configuration for version 1002"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      for="plone.base.interfaces.IMigratingPloneSiteRoot"
      directory="1002"
      />

  <gs:upgradeSteps
      profile="collective.plausible:default"
      source="1001"
      destination="1002"
      >

    <gs:upgradeStep
        title="Replace action linking to @@plausible-view"
        description=""
        handler=".v1002.upgrade"
        />

    <gs:upgradeDepends
        title="Replace action linking to @@plausible-view (GS profile)"
        description=""
        import_profile="collective.plausible.upgrades:1002"
        />

  </gs:upgradeSteps>

</configure>
